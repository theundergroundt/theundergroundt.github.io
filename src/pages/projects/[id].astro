---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, period, duration, team, role, category, color, repo, stack, duties, works } = project.data;
const hasDuties = Boolean(duties.summary) || duties.items.length > 0;
---

<Base title={title} description={summary}>
  <div style={`--c: ${color}`}>
    <a class="back" href="/projects/">← Projects</a>

    <div class="detail-head trace">
      <p class="category">{category}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <dl class="meta">
        <div><dt>기간</dt><dd>{period}{duration && ` (${duration})`}</dd></div>
        <div><dt>인원</dt><dd>{team}</dd></div>
        <div><dt>역할</dt><dd>{role}</dd></div>
      </dl>
      {
        repo && (
          <div class="links">
            <a class="btn" href={repo}>
              GitHub README
            </a>
          </div>
        )
      }
    </div>

    <section class="reveal">
      <div class="section-head"><h2>담당 역할</h2></div>
      {
        hasDuties ? (
          <div class="duties reveal-body">
            {duties.summary && <p class="duties-summary">{duties.summary}</p>}
            {duties.items.length > 0 && (
              <ul class="lines">
                {duties.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </div>
        ) : (
          <p class="empty reveal-body">내용 준비 중입니다.</p>
        )
      }
    </section>

    <section class="reveal">
      <div class="section-head"><h2>내가 한 일</h2></div>
      {
        works.length > 0 ? (
          <div class="works">
            {works.map((work) => (
              <article class="work trace">
                <h3>
                  {work.title}
                  {work.tag && <span class="tag">{work.tag}</span>}
                </h3>
                <ol class="steps">
                  {[
                    { label: '한 일', lines: work.did },
                    { label: '한 이유', lines: work.why },
                    { label: '결과 및 성과', lines: work.result, last: true },
                  ].map((step) => (
                    <li class:list={{ conclusion: step.last }}>
                      <span class="label">{step.label}</span>
                      {step.lines.length === 1 ? (
                        <p>{step.lines[0]}</p>
                      ) : (
                        <ul class="lines">
                          {step.lines.map((line) => (
                            <li>{line}</li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ol>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">내용 준비 중입니다.</p>
        )
      }
    </section>

    {
      stack.length > 0 && (
        <section class="reveal">
          <div class="section-head"><h2>사용 기술</h2></div>
          <ul class="chips reveal-body">
            {stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
